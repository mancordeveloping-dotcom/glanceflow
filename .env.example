# ─── Supabase ────────────────────────────────────────────────────────────────
# Public (exposed to browser — safe, these are anon credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co   # same URL, but non-public for admin client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...          # use sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Google AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=GlanceFlow <noreply@yourdomain.com>

# ─── App ─────────────────────────────────────────────────────────────────────
# Public — used for Stripe redirect URLs and Open Graph metadata
NEXT_PUBLIC_URL=https://yourdomain.com
