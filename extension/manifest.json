{
  "manifest_version": 3,
  "name": "GlanceFlow",
  "version": "1.0.0",
  "description": "Turn any screenshot into tasks with AI",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://glanceflow-git-main-mattiamancini047-5656s-projects.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
